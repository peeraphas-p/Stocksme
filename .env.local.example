# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ผู้ช่วย AI (หน้า "ถาม AI") — คีย์จาก console.anthropic.com > API Keys (ใช้ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# จำนวนคำถามต่อผู้ใช้ต่อวัน (ไม่ใส่ = 20)
AI_DAILY_LIMIT=20
